SIM = verilator
TOPLEVEL_LANG = verilog
SIM_BUILD = build/
export PYTHONPATH := $(CURDIR)/tb:$(PYTHONPATH)

COMMON_SOURCES = \
	$(CURDIR)/rtl/pkg/rv32i_pkg.sv \
	$(CURDIR)/rtl/pkg/alu_pkg.sv \
	$(CURDIR)/rtl/pkg/controller_pkg.sv \
	$(CURDIR)/rtl/pkg/lsu_pkg.sv

CORE_SOURCES = $(wildcard $(CURDIR)/rtl/core/*.sv)
MEMORY_SOURCES = $(wildcard $(CURDIR)/rtl/memory/*.sv)

VERILOG_SOURCES = $(COMMON_SOURCES) $(CORE_SOURCES) $(MEMORY_SOURCES) $(CURDIR)/rtl/top.sv

COCOTB_TOPLEVEL = top
COCOTB_TEST_MODULES = tb.top_tb

WAVES = 1

include $(shell cocotb-config --makefiles)/Makefile.sim

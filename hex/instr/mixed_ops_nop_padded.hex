// Same program as mixed_ops.hex, padded with NOPs so that a 5-stage pipeline
// without forwarding, stalling or flushing runs it correctly:
//   - Two NOPs between dependent instructions, as the register file writes through from WB to ID
//   - Two NOPs after branches and jumps, which resolve in EX, so the wrong-path fetches are harmless
00500093 // addi x1, x0, 5
00000013 // nop
00000013 // nop
00000113 // addi x2, x0, 0
00110133 // add  x2, x2, x1      // loop:
fff08093 // addi x1, x1, -1
00000013 // nop
00000013 // nop
fe0098e3 // bne  x1, x0, loop
00000013 // nop
00000013 // nop
123451b7 // lui  x3, 0x12345
00000013 // nop
00000013 // nop
6781e193 // ori  x3, x3, 0x678
40200233 // sub  x4, x0, x2
00000013 // nop
00000013 // nop
40225293 // srai x5, x4, 2
00411313 // slli x6, x2, 4
00302223 // sw   x3, 4(x0)
00400383 // lb   x7, 4(x0)
00601403 // lh   x8, 6(x0)
010004ef // jal  x9, skip
00000013 // nop
00000013 // nop
00100513 // addi x10, x0, 1      // skipped
0000006f // jal  x0, 0           // skip: halt
00000013 // nop
00000013 // nop
